{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keyword-judge",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true
  }
}
