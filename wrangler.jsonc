{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keyword-judge",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "FETCH_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
}
